# Cryonova environment variables. Copy to .env.local for local development.
# Never commit real values. In Vercel, store every secret as "Sensitive".

# Neon PostgreSQL. Pooled URL for the app runtime (serverless driver).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (unpooled) URL, used only by migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Anthropic API (server only). The app degrades to rule-based planning without it.
ANTHROPIC_API_KEY=
# Model used by the research agent.
ANTHROPIC_MODEL=claude-sonnet-5-5

# NASA Earthdata Login bearer token (MERRA-2, GPM IMERG via OPeNDAP).
EARTHDATA_TOKEN=

# Copernicus Climate Data Store (ERA5). Optional connector.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NOAA Climate Data Online web services token. Optional connector.
NOAA_CDO_TOKEN=

# Optional HMAC pepper for retrieval-code hashes. Changing it invalidates all codes.
CODE_PEPPER=

# Quotas and budget guards (defaults shown).
AI_DAILY_REQUEST_LIMIT=300
AI_DAILY_BUDGET_USD=5
RUNS_PER_HOUR_PER_CLIENT=30
CODE_LOOKUP_FAILURES_PER_10_MIN=15
# Provider concurrency per run (MERRA-2 baseline from Databricks benchmarks).
PROVIDER_CONCURRENCY=6
