{
  "name": "cryonova",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Earth system trend research with live NASA data (NASA Space Apps 2026).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "regions:generate": "tsx scripts/generate-regions.ts",
    "catalog:verify": "tsx scripts/verify-catalog.ts",
    "smoke:live": "tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/overpass": "5.3.0",
    "@neondatabase/serverless": "1.2.1",
    "drizzle-orm": "0.45.4",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "pdf-lib": "1.17.1",
    "plotly.js-cartesian-dist-min": "4.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "i18n-iso-countries": "7.14.0",
    "topojson-client": "3.1.0",
    "@types/topojson-client": "3.1.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "undici": "7.30.2",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2"
  }
}
